# Credenciales del panel administrativo (/admin)
# Copia este archivo a .env.local y cambia los valores antes de publicar el sitio.
ADMIN_USER=admin
ADMIN_PASSWORD=growthstack60d
ADMIN_SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Supabase (contenido del CMS + media library)
# Sacalas de tu proyecto en supabase.com -> Project Settings -> API Keys / Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Usa la connection string del "Transaction pooler" (IPv4), no la directa (IPv6-only)
DATABASE_URL=
